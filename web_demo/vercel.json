{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build:online",
  "outputDirectory": "dist-online",
  "rewrites": [
    {
      "source": "/models/baseline2_njr_fp32.onnx",
      "destination": "https://ruv1f22gd5afyug3.public.blob.vercel-storage.com/models/baseline2_njr_fp32-e2cdc94a06a7a7f72c763d46a92ef3ce84675fd9ae6a4664c94c6f5d99b66b69.onnx"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
